# Identifiants Rentila
RENTILA_EMAIL=votre.email@exemple.com
RENTILA_PASSWORD=votre-mot-de-passe

# Locataires
TENANT_EMAILS=locataire1@mail.com,locataire2@mail.com
TENANT_NAMES=Alice & Bob

# Gmail API (optionnel, crée un brouillon dans Gmail)
# 1. https://console.cloud.google.com → Activer Gmail API → Créer identifiants OAuth2
# 2. Copier Client ID et Client Secret ci-dessous
# 3. Exécuter : npm run auth:gmail → autoriser → coller le refresh token
# GMAIL_CLIENT_ID=xxx.apps.googleusercontent.com
# GMAIL_CLIENT_SECRET=xxx
# GMAIL_REFRESH_TOKEN=xxx
